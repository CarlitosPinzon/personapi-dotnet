@model IEnumerable<Estudio>

@{
    ViewData["Title"] = "Estudios";
}

<h1>Estudios</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Nuevo estudio</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Persona</th>
            <th>Profesion</th>
            <th>Universidad</th>
            <th>Fecha</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CcPer - @item.CcPerNavigation.Nombre @item.CcPerNavigation.Apellido</td>
                <td>@item.IdProfNavigation.Nom</td>
                <td>@item.Univer</td>
                <td>@item.Fecha?.ToString("yyyy-MM-dd")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
