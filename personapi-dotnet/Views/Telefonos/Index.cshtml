@model IEnumerable<Telefono>

@{
    ViewData["Title"] = "Telefonos";
}

<h1>Telefonos</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Nuevo telefono</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Numero</th>
            <th>Operador</th>
            <th>Dueno</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Num</td>
                <td>@item.Oper</td>
                <td>@item.Duenio - @item.DuenioNavigation.Nombre @item.DuenioNavigation.Apellido</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Num" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Num" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Num" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
