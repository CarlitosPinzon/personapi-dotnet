@model Telefono

@{
    ViewData["Title"] = "Eliminar telefono";
}

<h1>Eliminar telefono</h1>

<div class="alert alert-warning">Esta seguro de eliminar este telefono?</div>

<dl class="row">
    <dt class="col-sm-2">Numero</dt>
    <dd class="col-sm-10">@Model.Num</dd>
    <dt class="col-sm-2">Operador</dt>
    <dd class="col-sm-10">@Model.Oper</dd>
    <dt class="col-sm-2">Dueno</dt>
    <dd class="col-sm-10">@Model.Duenio - @Model.DuenioNavigation.Nombre @Model.DuenioNavigation.Apellido</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Num">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
