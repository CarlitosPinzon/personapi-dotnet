@model Telefono

@{
    ViewData["Title"] = "Detalle de telefono";
}

<h1>Telefono @Model.Num</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Numero</dt>
    <dd class="col-sm-10">@Model.Num</dd>
    <dt class="col-sm-2">Operador</dt>
    <dd class="col-sm-10">@Model.Oper</dd>
    <dt class="col-sm-2">Dueno</dt>
    <dd class="col-sm-10">
        <a asp-controller="Personas" asp-action="Details" asp-route-id="@Model.Duenio">
            @Model.Duenio - @Model.DuenioNavigation.Nombre @Model.DuenioNavigation.Apellido
        </a>
    </dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Num" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
