@model Persona

@{
    ViewData["Title"] = "Eliminar persona";
}

<h1>Eliminar persona</h1>

<div class="alert alert-warning">
    Se eliminara la persona junto con sus @Model.Telefonos.Count telefono(s) y @Model.Estudios.Count estudio(s). Esta seguro?
</div>

<dl class="row">
    <dt class="col-sm-2">Cedula</dt>
    <dd class="col-sm-10">@Model.Cc</dd>
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre @Model.Apellido</dd>
    <dt class="col-sm-2">Genero</dt>
    <dd class="col-sm-10">@Model.Genero</dd>
    <dt class="col-sm-2">Edad</dt>
    <dd class="col-sm-10">@Model.Edad</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Cc">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
