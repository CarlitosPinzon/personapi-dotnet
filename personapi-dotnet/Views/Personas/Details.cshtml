@model Persona

@{
    ViewData["Title"] = "Detalle de persona";
}

<h1>@Model.Nombre @Model.Apellido</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Cedula</dt>
    <dd class="col-sm-10">@Model.Cc</dd>
    <dt class="col-sm-2">Genero</dt>
    <dd class="col-sm-10">@(Model.Genero == "M" ? "Masculino" : "Femenino")</dd>
    <dt class="col-sm-2">Edad</dt>
    <dd class="col-sm-10">@Model.Edad</dd>
</dl>

<h4>Telefonos</h4>
@if (Model.Telefonos.Any())
{
    <ul>
        @foreach (var t in Model.Telefonos)
        {
            <li>@t.Num (@t.Oper)</li>
        }
    </ul>
}
else
{
    <p class="text-muted">No tiene telefonos registrados.</p>
}

<h4>Estudios</h4>
@if (Model.Estudios.Any())
{
    <ul>
        @foreach (var e in Model.Estudios)
        {
            <li>@e.IdProfNavigation.Nom - @e.Univer @(e.Fecha.HasValue ? $"({e.Fecha:yyyy-MM-dd})" : "")</li>
        }
    </ul>
}
else
{
    <p class="text-muted">No tiene estudios registrados.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Cc" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
